# Super Sync 服务器 - 生产环境配置
# 将本文件复制为 .env，并填写所有必填项

# =============================================================================
# 必填设置
# =============================================================================

# 你的域名（不含 https://）
# Caddy 会自动为该域名申请 SSL 证书
DOMAIN=sync.your-domain.com

# 用于签发认证令牌的 JWT 密钥（至少 32 个字符）
# 生成命令：openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters

# 数据库的 PostgreSQL 密码
# 生成命令：openssl rand -base64 24
POSTGRES_PASSWORD=your-secure-postgres-password

# 本服务器的公网 URL（含协议）。必填。
# 用于验证邮件 / 魔法链接 / 恢复邮件中的链接，因此必须是用户能访问到的地址，
# 而不是容器内部地址。当 NODE_ENV=production（Docker 默认）时，必须以 https://
# 开头——否则服务器会拒绝启动。
PUBLIC_URL=https://sync.your-domain.com

# =============================================================================
# 通行密钥 / WebAuthn 设置（通行密钥登录必填）
# =============================================================================

# 依赖方 ID（Relying-party ID）：你的域名，不含协议或端口。通行密钥绑定到该值，
# 之后再改会使所有已注册凭证失效。
WEBAUTHN_RP_ID=sync.your-domain.com

# 用户访问认证界面的地址，需含协议。通常与 PUBLIC_URL 相同。
WEBAUTHN_ORIGIN=https://sync.your-domain.com

# 在用户操作系统通行密钥提示中显示的名称。默认等于 WEBAUTHN_RP_ID。
# WEBAUTHN_RP_NAME=Your Service Name

# =============================================================================
# 服务器设置（可选 — 已有默认值）
# =============================================================================

# 服务器绑定地址（默认：0.0.0.0）
# 仅 IPv6 部署时使用 ::。
HOST=0.0.0.0

# 限制谁可以注册：逗号分隔的精确邮箱，和/或 *@域名 规则。
# 不设置则任何能访问服务器的人都可以注册。
# ALLOWED_EMAILS=you@example.com,*@your-domain.com

# 每用户存储配额（字节，默认 104857600 = 100 MB）。该默认值只作用于
# 此后新建的账户；已有账户保留创建时写入行上的配额。
# SUPERSYNC_DEFAULT_STORAGE_QUOTA_BYTES=104857600

# =============================================================================
# 数据库设置（可选 — 已有默认值）
# =============================================================================

# PostgreSQL 用户（默认：supersync）
# POSTGRES_USER=supersync

# PostgreSQL 数据库名（默认：supersync）
# POSTGRES_DB=supersync

# 自带 Postgres 容器的内存上限，以及必须与之匹配的规划器提示
# （默认：1536m / 1GB — 发行默认值；提高为可选项）。这是同一个决策，不是两个：
# 在 cgroup v2 下，Postgres 能摸到的 page cache 会计入该 cgroup，因此是这个上限
# ——而非宿主机整机 RAM——限制了 operations 堆有多少能留在缓存里。
# 小 VPS 请把两者一起调低。若上限 ≥ 整机内存，会失去 cgroup 隔离：
# 随后由宿主机 OOM killer 选牺牲品，甚至可能杀掉 sshd。
# 提示值经验法则：(limit - shared_buffers)，即 limit - 384MB。
# 同时调高二者会在下次 `up -d` 时重建 postgres 容器并丢掉热 page cache——
# 请择机进行，不要在部署中途踩中。
# POSTGRES_MEM_LIMIT=2048m
# POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB

# 外部 PostgreSQL 连接串。留空则使用 compose 自带的 postgres 服务。
# 自带服务地址为 postgres:5432；db:5432 仍作为旧 .env 的兼容别名保留。
# 若指向外部主机，请同时将下方 POSTGRES_SERVICE= 设为空值。
#
# 重要：请追加 ?connection_limit=N&pool_timeout=10 以限制 Prisma 连接池。
# Prisma 默认池大小约为 ~(宿主机 CPU 核数 * 2)，读的是宿主机核数——
# 不是容器 CPU 限制。在多核宿主机上，无界连接池会悄悄占满 postgres 的
# max_connections（compose 中为 120），导致 psql、迁移、旧操作清理任务，
# 或崩溃恢复后的重连风暴没有余量 -> "sorry, too many clients already"，
# 并引发全员 WebSocket 重连风暴。请让 N 明显低于 max_connections（例如 60）。
#
# 在此设置 DATABASE_URL 会整段替换 compose 默认值，上述参数不会继承——
# 必须显式写在连接串里。
# DATABASE_URL=postgresql://supersync:password@example.com:5432/supersync?connection_limit=60&pool_timeout=10
#
# 可选恢复护栏 — 仅在检查过遗留历史后再启用：
#   ...&options=-c%20statement_timeout%3D60000
# 没有它时，一条退化查询计划会占住连接池连接，直到有人手动杀掉：
# 在 2026-07-20 的故障中长达 75 分钟，耗尽整个连接池，导致所有用户同步失败，
# 包括与该坏查询无关的请求。Prisma 的事务超时只中止客户端侧；后端查询仍会继续。
# 该选项使连接池耗尽可恢复，而不是进入服务器无法自行脱出的状态；此前三次
# operations 表相关事故中都没有它。只有写在连接串里的形式才有效——Prisma 会覆盖
# ALTER ROLE 与 ALTER DATABASE 的 statement_timeout。请保留所示的 %20（空格）
# 与 %3D（=）编码，以便各类 URL 工具可移植。
#
# 默认不启用，因为有一条遗留路径会合法超过 60 秒：
# `_computeSnapshotVectorClock`（src/sync/services/operation-download.service.ts）
# 会聚合用户整段历史的向量钟；因大历史会撞上 60s 事务预算，已移出事务外执行。
# 当持久化的 snapshot-clock 元数据缺失、过期或无效时会运行。在历史很长的升级实例上，
# 60s 上限可能使这类下载变成确定性的 500。请确认该回退路径对你的用户已不再触发，
# 或把预算设到高于最坏情况。（#9191）
#
# scripts/migrate-deploy.sh 会为迁移器用有限 statement timeout 替换该上限
# （比 MIGRATE_STEP_TIMEOUT 少约 5 秒），以便长时间 CREATE INDEX CONCURRENTLY
# 不会留下无界后端查询。
#
# 监控脚本同样会替换（scripts/monitoring-db.ts）：全站报告不是面向用户的，
# 因此在 MONITOR_STATEMENT_TIMEOUT_MS（默认 300000）下运行，并以
# application_name 'supersync-monitor' 标识自身，避免 health-alert.sh
# 因长报告而告警。
# MONITOR_STATEMENT_TIMEOUT_MS=300000

# =============================================================================
# CORS 设置
# =============================================================================

# 允许的 CORS 来源（逗号分隔）
# 默认：https://app.super-productivity.com
# 若自托管前端，请追加你的前端 URL。
# 支持子域名通配：https://*.example.com
# 生产环境切勿使用 "*"：CORS 以 credentials: true 运行，通配会反射任意来源，
# 使任意网站能以用户名义发起已认证请求。
CORS_ORIGINS=https://app.super-productivity.com

# =============================================================================
# SMTP 配置（邮箱验证所需）
# =============================================================================

# SMTP 服务器主机名
SMTP_HOST=smtp.your-email-provider.com

# SMTP 端口（TLS 默认 587，SSL 用 465）
SMTP_PORT=587

# 是否使用 SSL/TLS（465 端口为 true；587 上 STARTTLS 为 false）
SMTP_SECURE=false

# SMTP 认证凭据
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# 发件地址
# 整段必须放在一对引号内，否则 docker compose 会把 < 当成非法变量名
SMTP_FROM="Super Productivity Sync <noreply@your-domain.com>"

# =============================================================================
# 法律页面（可选 — 但请阅读下方警告）
# =============================================================================
#
# 镜像不附带服务条款；在你于此处表明自己是数据控制者之前，也不会生成隐私政策。
# 这是刻意的：若政策点名别人的托管商，或要求用户接受德国法下的条款，
# 就会变成以你名义发布的虚假法律声明。
#
# 须设置以下全部五项，才会发布 /privacy.html 并显示注册同意提示。
# 全部不设则法律页面根本不提供。只设一部分是启动错误，而非静默回退。
#
# PRIVACY_CONTACT_NAME=Your Name or Company
# PRIVACY_ADDRESS_STREET=Example Street 1
# PRIVACY_ADDRESS_CITY=12345 Example City
# PRIVACY_ADDRESS_COUNTRY=Germany
# PRIVACY_CONTACT_EMAIL=contact@your-domain.com

# 可选：托管提供商（若第三方代表你处理数据）。未设置时政策中完全省略。
# 换行会变成行分隔，因此可以写完整地址块。
# PRIVACY_HOSTING_PROVIDER=Example Hosting GmbH, Example Street 1, 12345 City, Germany

# 可选：对你有管辖权的数据保护监管机构。未设置时，政策会引导用户联系其居住地监管机构。
# PRIVACY_SUPERVISORY_AUTHORITY=Your State Data Protection Commissioner, https://example.gov/

# 可选：实例存放用户数据的位置。设为 EU（或 EEA）可在落地页显示「数据托管于欧盟」徽章。
# 其它任何值都不显示徽章——在「托管于美国」上方挂欧盟旗，正是法律页改版要避免的虚假主张。
# 请在隐私政策中如实写明实际位置。
# PRIVACY_DATA_REGION=EU

# 要发布你自己的服务条款，请将 HTML 放在 <DATA_DIR>/legal/terms.html ——
# 启动时会复制到 /terms.html，并从同意提示中链接。

# 由 scripts/deploy.sh 驱动的部署：设为 true 时，每次部署将检出中的
# legal/terms.html 同步到数据卷，以仓库为事实来源。仅当你检出中的文件确实是
# 「你的」条款时才设置——在原版检出里，那是德国法下托管实例的 ToS。
# SUPERSYNC_INSTALL_REPO_TERMS=true

# =============================================================================
# 容器镜像仓库（用于 build-and-push.sh）
# =============================================================================

# 仅在你发布自己的镜像时需要；拉取官方镜像无需凭据。

# 覆盖本栈运行的镜像。上游只发布 `latest` 与 `master-<sha>` —
# 在此钉到某个 master-<sha> 可固定版本，或指向你自己的镜像。
# SUPERSYNC_IMAGE=ghcr.io/super-productivity/supersync:master-0d456c0

# GHCR 的 GitHub 用户名
# GHCR_USER=your-github-username

# build-and-push.sh 发布到的命名空间。默认 super-productivity，你无法推送到该处 —
# 请设为你自己的账号或组织。
# GHCR_NAMESPACE=your-github-username

# GitHub token。从工作站推送（build-and-push.sh）需要 “Packages: Read and write”；
# 部署机上若只需拉取，应使用只读 token。不要把可写 token 放进服务器的 .env。
# 创建地址：https://github.com/settings/tokens?type=beta
# GHCR_TOKEN=your-github-token

# =============================================================================
# 高级设置（通常无需修改）
# =============================================================================

# 日志级别（info, debug, warn, error）
# LOG_LEVEL=info

# 默认关闭启动时迁移。生产与本地 Docker 部署请使用 scripts/deploy.sh，
# 以便在替换应用容器之前先跑一次迁移。仅在一次性/手动运行时设为 true。
# RUN_MIGRATIONS_ON_STARTUP=false

# 用于数据库就绪检查的 Compose 服务名。留空则使用自带的 postgres 服务。
# 仅当 DATABASE_URL 指向外部数据库时，将 POSTGRES_SERVICE= 设为空值；
# 随后 deploy.sh 会在无 compose 依赖的情况下启动 supersync/caddy。
# Prisma 迁移仍针对已配置的 DATABASE_URL 运行。
# POSTGRES_SERVICE=

# 旧操作保留清理按有界批次删除，避免积压独占 PostgreSQL。在更大服务器上请谨慎提高。
# BATCH_SIZE 是每条 DELETE 语句的 serverSeq 窗口宽度（同时也限制单条语句可删行数）—
# 所述范围用于无论历史状态如何，都让每条语句落在 statement_timeout 内（#9692）。
# OLD_OPS_CLEANUP_DELETE_BATCH_SIZE=5000
# OLD_OPS_CLEANUP_MAX_DELETED_PER_RUN=25000
#
# 消化积压时：每次运行的预算按稳态设计——大约一天的过期操作——不是为保留清理失败后的追赶，
# 且清扫每天只跑一次，因此默认约清 25k/天（440 万行积压大约要半年）。
# 可用只读命令 `npm run dry-run-old-ops-sweep` 对照真实数字临时调高，然后再改回去—
# 引流期间要观察的信号见 MONITORING-README.md「Digging out of an ops backlog」。

# ./scripts/deploy.sh 中 `prisma migrate deploy` 的超时（秒）。
# 在线建索引（CREATE INDEX CONCURRENTLY）可能被长时间事务阻塞；超大表请提高
# （大 operations 表可从 3600 试起——默认 900 可能在慢速建索引中途 SIGTERM）。
# 超时的迁移容器现在会被强制移除，因此过低的值不再会因泄漏的 advisory lock（P1002）
# 卡住下一次部署；部署会明确失败并给出可复制粘贴的恢复步骤。注意：被中断的
# CREATE INDEX CONCURRENTLY 仍可能需要一次性删除 INVALID 索引（失败输出会打印确切步骤）
# 后重跑才能成功。退出码 124 = 超时。
# MIGRATION_TIMEOUT=900

# 镜像内每个迁移步骤的超时（秒）。deploy.sh 会从 MIGRATION_TIMEOUT 推导
# （减去一点余量）并传入，因此走 deploy.sh 时调高 MIGRATION_TIMEOUT 即可。
# 仅在镜像 CMD / helm initContainer 路径（没有外层宿主机超时）时直接设置本项。
# 未设置时镜像内默认 1800。
# MIGRATE_STEP_TIMEOUT=

# 针对没有 org.opencontainers.image.revision 标签的自定义/私有镜像的安全阀。
# 生产环境请保持未设置；部署脚本用该标签防止把新的 SuperSync 部署输入
# 与过期的 supersync 镜像混用。
# SUPERSYNC_SKIP_IMAGE_REVISION_CHECK=false
